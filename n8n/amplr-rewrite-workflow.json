    "nodes": [
      {
        "id": "amplr-webhook",
        "name": "Amplr Rewrite Webhook",
        "parameters": {
          "httpMethod": "POST",
          "options": {
            "allowedOrigins": "*"
          },
          "path": "amplr-rewrite",
          "responseMode": "responseNode"
        },
        "position": [
          240,
          300
        ],
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "webhookId": "amplr-rewrite-prod"
      },
      {
        "id": "ollama-generate",
        "name": "Rewrite with local Ollama",
        "parameters": {
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ]
          },
          "jsonBody": "={{ JSON.stringify({ model: 'qwen3:8b', stream: false, options: { temperature: 0.45 }, prompt: `Act like a QuillBot-style paraphraser for Facebook group posts. Preserve the original meaning, offer, facts, tone level, links, and call to action. Rewrite the wording and sentence structure naturally without adding new claims, hype, emojis, hashtags, or extra details. Do not make it more salesy. Output ONLY the paraphrased post text, nothing else.\\n\\nCurrent message:\\n${$json.body?.message || $json.message || ''}\\n\\nParaphrase instruction from user:\\n${$json.body?.instruction || $json.instruction || 'Paraphrase naturally while keeping the same meaning.'}\\n\\nRecent versions to avoid repeating exactly:\\n${JSON.stringify($json.body?.history || [])}` }) }}",
          "method": "POST",
          "options": {},
          "sendBody": true,
          "sendHeaders": true,
          "specifyBody": "json",
          "url": "http://127.0.0.1:11434/api/generate"
        },
        "position": [
          500,
          300
        ],
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2
      },
      {
        "id": "shape-response",
        "name": "Shape Amplr Response",
        "parameters": {
          "jsCode": "const raw = $json.response || $json.text || $json.output || '';\nreturn [{ json: { rewritten: String(raw).trim(), ok: true, ollama_model: 'qwen3:8b', raw: $json } }];"
        },
        "position": [
          740,
          300
        ],
        "type": "n8n-nodes-base.code",
        "typeVersion": 2
      },
      {
        "id": "respond",
        "name": "Return rewritten copy",
        "parameters": {
          "options": {
            "responseHeaders": {
              "entries": [
                {
                  "name": "Access-Control-Allow-Origin",
                  "value": "*"
                },
                {
                  "name": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          },
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ rewritten: $json.rewritten || '', ok: true, ollama_model: $json.ollama_model || null }) }}"
        },
        "position": [
          980,
          300
        ],
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1
      }
    ],
