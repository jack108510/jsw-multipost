{
  "manifest_version": 3,
  "name": "Reachr fb poster",
  "short_name": "Reachr fb poster",
  "version": "2.2.128",
  "description": "Post to multiple Facebook groups at once. AI-powered prompts, scheduled posts, dashboard pairing.",
  "author": "JSW Enterprises",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reachr fb poster",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jack108510.github.io/jsw-multipost/*",
        "https://jack108510.github.io/fb-autoposter/*"
      ],
      "js": [
        "dashboard_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "alarms",
    "cookies",
    "debugger"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://api.openai.com/*",
    "*://api.anthropic.com/*",
    "*://generativelanguage.googleapis.com/*",
    "*://openrouter.ai/*",
    "*://*.supabase.co/*",
    "https://*/*",
    "http://localhost:11434/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ]
}
